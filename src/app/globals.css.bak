ottom:14px}.context-strip>div,.audit-scope>div{display:grid}.context-strip small,.audit-scope small{color:#91a0b6;font-size:9px}.context-strip strong,.audit-scope strong{font-size:11px}.context-strip .badge{margin-left:auto}.scenario-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-bottom:14px}.scenario-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;position:relative;overflow:hidden}.scenario-card.recommended{border:2px solid #315fce;padding:17px}.recommend-ribbon{margin:-17px -17px 15px;background:#315fce;color:#fff;text-align:center;padding:6px;font-size:9px;font-weight:650}.scenario-number{font-size:10px;color:#8993a3;font-weight:700}.radio{font-size:10px;display:flex;gap:4px}.scenario-card h2{font-size:20px;margin:12px 0 5px}.scenario-card>p{font-size:11px;color:var(--muted);min-height:48px}.scenario-stats{display:grid;grid-template-columns:1fr 1fr;background:#f6f8fb;border-radius:9px;margin:14px 0}.scenario-stats>div{display:grid;padding:10px;border-bottom:1px solid #e4e8ef}.scenario-stats span{font-size:9px;color:var(--muted)}.scenario-stats strong{font-size:12px}.scenario-card ul{padding:0;list-style:none;display:grid;gap:7px;font-size:11px}.scenario-card li span{color:#16765a;margin-right:7px}.scenario-confidence{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:7px;font-size:9px;margin:15px 0}.assumption-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.assumption-grid>div{display:flex;gap:9px;padding:11px;background:#f6f8fb;border-radius:9px}.assumption-grid svg{width:17px;color:#315fce;flex:none}.assumption-grid p{margin:2px 0;font-size:10px;color:var(--muted)}.audit-scope svg{color:#66d7aa}.audit-scope>div{flex:1}.audit-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(290px,.65fr);gap:14px}.trace-chain{display:grid}.trace-item{display:grid;grid-template-columns:32px 1fr auto;gap:10px;padding:13px 0;border-bottom:1px solid #edf0f4;position:relative}.trace-item>span{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#e7f5ef;color:#16765a;font-weight:700}.trace-item.warning>span{background:#fff1dc;color:#a76213}.trace-item h3{margin:5px 0 2px}.trace-item p{font-size:10px;color:var(--muted);margin:0}.trace-item button{border:0;background:transparent;color:#315fce;font-size:10px}.timeline-row{display:flex;gap:11px;position:relative;padding-bottom:17px}.timeline-row i{width:9px;height:9px;border-radius:50%;background:#a7b0bf;margin-top:5px;position:relative}.timeline-row i:after{content:"";position:absolute;top:11px;left:4px;height:45px;width:1px;background:#dfe4eb}.timeline-row:last-of-type i:after{display:none}.timeline-row i.active{background:#16765a}.timeline-row>div{display:grid}.timeline-row small{font-size:9px;color:var(--muted)}.timeline-row strong{font-size:11px}.timeline-row span{font-size:10px;color:#7a8495}.guardrail-banner{margin-top:14px;border:1px solid #cce5dc;background:#edf8f4;border-radius:12px;padding:14px 18px;display:flex;gap:11px}.guardrail-banner svg{color:#16765a}.guardrail-banner p{margin:2px 0;color:#537368;font-size:11px}
.login-page{min-height:100vh;display:grid;grid-template-columns:minmax(380px, .85fr) 1.15fr;background:#fff}.login-story{background:radial-gradient(circle at 80% 20%,rgba(82,126,233,.28),transparent 31%),linear-gradient(145deg,#101827,#172b4a);padding:38px 55px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;min-height:100vh}.brand.inverse{padding:0;height:auto}.login-story>div:nth-child(2){max-width:580px}.login-story h1{font-size:46px;line-height:1.08;max-width:620px}.login-story>div:nth-child(2)>p:not(.eyebrow){color:#b6c2d4;font-size:16px;max-width:540px}.login-story ul{padding:0;list-style:none;display:grid;gap:14px;margin-top:30px}.login-story li{display:flex;align-items:center;gap:10px}.login-story li svg{color:#74a1ff}.login-story footer{font-size:10px;color:#8593a8}.login-form-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;background:#fbfcfe}.login-form{width:min(390px,100%);background:#fff;border:1px solid #e0e5ed;border-radius:18px;padding:34px;box-shadow:var(--shadow)}.login-form h2{font-size:25px;margin:0 0 6px}.login-form>p:not(.eyebrow){color:var(--muted);margin-bottom:24px}.login-form label{display:grid;gap:6px;font-size:11px;font-weight:650;margin-bottom:15px}.login-form label>span{display:flex;justify-content:space-between}.login-form label a,.login-help a{color:var(--primary)}.login-form input{height:42px;border:1px solid #ccd4df;border-radius:9px;padding:0 11px;color:var(--ink);background:#fff}.login-form input:focus{outline:3px solid #dce6ff;border-color:#315fce}.or{height:25px;position:relative;text-align:center;margin:9px 0}.or:before{content:"";height:1px;background:#e2e6ed;position:absolute;left:0;right:0;top:12px}.or span{background:#fff;padding:0 8px;position:relative;color:#8993a3;font-size:10px}.sso-mark{width:20px;height:20px;border-radius:4px;display:grid;place-items:center;background:#192944;color:white}.legal{display:block;text-align:center;color:#8a94a4;margin-top:18px;font-size:9px}.login-help{margin-top:20px;color:#778295;font-size:11px}.mobile-login-brand{display:none}.fade-in{animation:fade .28s ease-out}@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}:focus-visible{outline:3px solid #83a5fa;outline-offset:2px}
@media(max-width:1100px){.metrics-grid{grid-template-columns:1fr 1fr}.dashboard-grid,.content-grid,.study-detail-grid,.gap-layout,.audit-layout{grid-template-columns:1fr}.scenario-grid{grid-template-columns:1fr 1fr}.search-button{min-width:220px}.stepper small{display:none}}
@media(max-width:760px){h1{font-size:25px}.mobile-only{display:inline-flex}.sidebar{transform:translateX(-105%);transition:.22s;box-shadow:12px 0 40px rgba(0,0,0,.25)}[dir="rtl"] .sidebar{transform:translateX(105%)}.sidebar.sidebar--open{transform:none}.workspace{margin:0;width:100%}.topbar{padding:0 14px;height:58px;gap:8px}.scope-button span,.search-button,.topbar-actions .icon-button:last-child{display:none}.scope-button{flex:1}.scope-button strong{font-size:10px}.page{padding:23px 15px 40px}.page-header{align-items:flex-start;display:grid}.header-actions{width:100%}.header-actions .button{flex:1}.metrics-grid{grid-template-columns:1fr 1fr}.metric{min-height:110px;padding:13px}.metric>strong{font-size:24px}.dashboard-grid,.dashboard-grid.lower,.study-grid,.scenario-grid{grid-template-columns:1fr}.risk-item{grid-template-columns:42px 1fr 14px}.risk-trend{display:none}.data-trust{align-items:flex-start}.data-trust .confidence{display:none}.heat-row{grid-template-columns:100px 1fr 35px}.heat-row small{display:none}.toolbar{align-items:flex-start;flex-direction:column}.tabs{overflow:auto;width:100%;flex-wrap:nowrap}.tabs button{white-space:nowrap}.content-grid{display:block}.content-grid>.inspector{margin-top:14px}.stage-summary{grid-template-columns:repeat(5,100px);overflow:auto}.study-status{grid-template-columns:1fr 1fr}.study-status>div{border:0}.stepper{grid-template-columns:repeat(12,46px);overflow:auto}.evidence-source-list>div{grid-template-columns:1fr 70px}.evidence-source-list .progress{display:none}.panel-foot{display:grid}.assumption-grid{grid-template-columns:1fr}.context-strip{align-items:flex-start;flex-wrap:wrap}.context-strip .badge{margin:0}.audit-scope{align-items:flex-start}.audit-scope .button{display:none}.evidence-ledger{align-items:flex-start;display:grid;gap:12px}.login-page{display:block;background:#f7f9fc;padding:18px;min-height:100vh}.login-story{display:none}.login-form-wrap{padding:35px 0;background:transparent}.login-form{padding:26px 20px}.mobile-login-brand{display:flex;align-items:center;gap:8px;margin-bottom:25px}.scrim{position:fixed;inset:0;background:rgba(5,11,22,.56);z-index:25;border:0;width:100%}}
@media(max-width:430px){.metrics-grid{grid-template-columns:1fr}.page-header h1{font-size:24px}.success-grid{grid-template-columns:1fr}.scenario-card{padding:16px}.login-form{border:0;box-shadow:none}.login-page{padding:0;background:#fff}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
.live-data-slot{max-width:calc(1600px - 76px);margin:-28px auto 52px;padding:0 38px}.backend-truth{border-style:dashed}.backend-rows{display:grid;gap:7px}.backend-rows>div{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#f7f9fc;border-radius:8px;padding:10px}.backend-rows span:first-child{display:grid}.backend-rows small{color:var(--muted);font-size:10px}.backend-message{padding:12px;background:#f5f7fa;border-radius:8px;color:var(--muted)}.backend-message.error,.login-error{background:#fdebed;color:#962a34}.as-of{display:block;margin-top:10px;color:#7c8799}.login-error{border-radius:8px;padding:9px;margin-bottom:12px;font-size:11px}@media(max-width:760px){.live-data-slot{padding:0 15px;margin:-20px auto 40px}}
