# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

POSTGRES_DB=ik_osa
POSTGRES_USER=ik_osa
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://ik_osa:local-only-change-me@postgres:5432/ik_osa
IK_DATA_DIR=.data

# Development-only seed identities. Production authenticates through OIDC/SAML.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@northstar.example
SEED_ADMIN_PASSWORD=Demo!2026
SEED_ANALYST_EMAIL=analyst@northstar.example
SEED_ANALYST_PASSWORD=Demo!2026
SEED_MANAGER_EMAIL=manager@northstar.example
SEED_MANAGER_PASSWORD=Demo!2026
SEED_SUPERVISOR_EMAIL=supervisor@northstar.example
SEED_SUPERVISOR_PASSWORD=Demo!2026
SEED_LEARNER_EMAIL=technician@northstar.example
SEED_LEARNER_PASSWORD=Demo!2026
SEED_AUDITOR_EMAIL=admin@northstar.example
SEED_AUDITOR_PASSWORD=Demo!2026

AUTH_SECRET=development-secret-replace-with-32-random-bytes
AUDIT_HASH_SECRET=development-audit-secret-replace-me
OTEL_SERVICE_NAME=ik-osa
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=Information

# Playwright
E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_URL=http://127.0.0.1:3000
E2E_TENANT_SLUG=northstar
E2E_CROSS_TENANT_SLUG=gulf-energy
E2E_ADMIN_EMAIL=admin@northstar.example
E2E_ADMIN_PASSWORD=Demo!2026
E2E_ANALYST_EMAIL=analyst@northstar.example
E2E_ANALYST_PASSWORD=Demo!2026
E2E_MANAGER_EMAIL=manager@northstar.example
E2E_MANAGER_PASSWORD=Demo!2026
E2E_LEARNER_EMAIL=technician@northstar.example
E2E_LEARNER_PASSWORD=Demo!2026
E2E_AUDITOR_EMAIL=admin@northstar.example
E2E_AUDITOR_PASSWORD=Demo!2026
